{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grepo.invalid/contracts/1.0/grepo.schema.json",
  "title": "Grepo core design contracts 1.0",
  "$comment": "Design specification, not generated from or implemented by the inspected starter. Examples marked fixture_only are synthetic.",
  "oneOf": [
    {
      "$ref": "#/$defs/Graph"
    },
    {
      "$ref": "#/$defs/Answer"
    },
    {
      "$ref": "#/$defs/Finding"
    },
    {
      "$ref": "#/$defs/ChangePack"
    },
    {
      "$ref": "#/$defs/AnalysisRun"
    },
    {
      "$ref": "#/$defs/ApiError"
    }
  ],
  "$defs": {
    "SourceRange": {
      "type": "object",
      "properties": {
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "line_start",
        "line_end"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "file_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "$ref": "#/$defs/SourceRange"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "enum": [
            "observed",
            "resolved",
            "inferred"
          ]
        }
      },
      "required": [
        "id",
        "snapshot_id",
        "file_id",
        "path",
        "range",
        "content_sha256",
        "basis"
      ],
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "file",
            "folder",
            "symbol",
            "package",
            "external",
            "contract"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "path",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "target_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "contains",
            "imports",
            "calls",
            "references",
            "exports",
            "declares_dependency",
            "implements_contract",
            "tests",
            "inferred_related"
          ]
        },
        "basis": {
          "enum": [
            "observed",
            "resolved",
            "inferred"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "required": [
        "id",
        "source_id",
        "target_id",
        "kind",
        "basis",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "inventoried_files": {
          "type": "integer",
          "minimum": 0
        },
        "parsed_files": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_references": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "inventoried_files",
        "parsed_files",
        "unresolved_references",
        "excluded_paths",
        "limitations",
        "truncated"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "fixture_only": {
          "type": "boolean"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "schema_version",
        "snapshot_id",
        "fixture_only",
        "entities",
        "relations",
        "evidence",
        "coverage"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "observed",
            "resolved",
            "inferred",
            "unknown",
            "hypothetical"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "required": [
        "text",
        "basis",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "Answer": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "enum": [
            "pending",
            "draft",
            "validated",
            "failed",
            "cancelled"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "follow_ups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3
        },
        "model_config_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "snapshot_id",
        "status",
        "question",
        "claims",
        "evidence",
        "limitations",
        "follow_ups",
        "model_config_id",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "reuse",
            "duplicate",
            "unused"
          ]
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "counter_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "reviewed",
            "dismissed",
            "intentional"
          ]
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "snapshot_id",
        "kind",
        "subject_ids",
        "method",
        "evidence_ids",
        "counter_evidence",
        "limitations",
        "recommendation",
        "review_status",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "ChangePack": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "github",
                "zip"
              ]
            },
            "repository": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "archive_sha256": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "repository",
            "revision",
            "archive_sha256"
          ],
          "additionalProperties": false
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "source_is_read_only": {
          "const": true
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "existing_helpers_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "fixture_only": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "snapshot_id",
        "source",
        "intent",
        "source_is_read_only",
        "observations",
        "existing_helpers_considered",
        "proposed_steps",
        "unknowns",
        "verification_steps",
        "evidence",
        "fixture_only"
      ],
      "additionalProperties": false
    },
    "AnalysisRun": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "partial",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cancel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "snapshot_id",
        "status",
        "stage",
        "event_sequence",
        "diagnostics",
        "cancel_requested"
      ],
      "additionalProperties": false
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "request_id",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}